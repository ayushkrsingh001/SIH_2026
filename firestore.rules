rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: Check if the user is authenticated
    function isAuth() {
      return request.auth != null;
    }

    // Helper: Check if the user is the document owner
    function isOwner(uid) {
      return isAuth() && request.auth.uid == uid;
    }

    // Helper: Check if the user is an admin
    function isAdmin() {
      return isAuth() && request.auth.token.role == 'admin';
    }

    // Parents collection
    match /parents/{parentId} {
      allow read: if isOwner(parentId);
      allow create: if isAuth() && request.auth.uid == parentId;
      allow update: if isOwner(parentId);
      allow delete: if false; // Parents cannot delete their own account via Firestore

      // Children sub-collection
      match /children/{childId} {
        allow read, write: if isOwner(parentId);
      }
    }

    // Modules (public read, admin write)
    match /modules/{moduleId} {
      allow read: if isAuth();
      allow write: if isAdmin();

      // Scenes sub-collection
      match /scenes/{sceneId} {
        allow read: if isAuth();
        allow write: if isAdmin();
      }
    }

    // Progress
    match /progress/{progressId} {
      allow read: if isAuth() && (
        resource.data.parentId == request.auth.uid || isAdmin()
      );
      allow create, update: if isAuth() && request.resource.data.parentId == request.auth.uid;
      allow delete: if false;
    }

    // Badges (public read, admin write)
    match /badges/{badgeId} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }

    // Community Posts
    match /communityPosts/{postId} {
      allow read: if isAuth(); // Allow reading all posts for the feed (filtering is done on client/query)
      allow create: if isAuth();
      allow update: if isAuth() && (resource.data.authorId == request.auth.uid || isAdmin());
      allow delete: if isAdmin() || (isAuth() && resource.data.authorId == request.auth.uid);
    }

    match /communityLikes/{likeId} {
      allow read: if isAuth();
      allow write: if isAuth();
    }
    
    match /communityComments/{commentId} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow update, delete: if isAuth() && (resource.data.authorId == request.auth.uid || isAdmin());
    }

    // ========== COMMUNITY V2 COLLECTIONS ==========
    
    match /campaigns/{docId} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }
    
    match /campaignParticipations/{docId} {
      allow read: if isAuth() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuth() && resource.data.userId == request.auth.uid;
    }
    
    match /weeklyChallenges/{docId} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }
    
    match /weeklyChallengeProgress/{docId} {
      allow read: if isAuth() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuth() && resource.data.userId == request.auth.uid;
    }
    
    match /nearbyEvents/{docId} {
      allow read: if isAuth();
      allow write: if isAdmin();
      // Allow users to update registeredCount
      allow update: if isAuth(); 
    }
    
    match /eventRegistrations/{docId} {
      allow read: if isAuth() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
      allow delete: if isAuth() && resource.data.userId == request.auth.uid;
    }
    
    match /chatSessions/{docId} {
      allow read: if isAuth() && resource.data.userId == request.auth.uid;
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuth() && resource.data.userId == request.auth.uid;
      allow delete: if isAuth() && resource.data.userId == request.auth.uid;
    }
    
    match /legalNews/{docId} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }
    
    match /newsReadStatus/{docId} {
      allow read: if isAuth() && resource.data.userId == request.auth.uid;
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
    }
    
    match /mythFacts/{docId} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }
    
    match /mythFactProgress/{docId} {
      allow read: if isAuth() && resource.data.userId == request.auth.uid;
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
    }
    
    match /imageDecisionProgress/{docId} {
      allow read: if isAuth() && resource.data.userId == request.auth.uid;
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuth() && resource.data.userId == request.auth.uid;
    }
    
    match /feedQuizzes/{docId} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }
    
    match /feedQuizAttempts/{docId} {
      allow read: if isAuth() && resource.data.userId == request.auth.uid;
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
    }
    
    match /awarenessShorts/{docId} {
      allow read: if isAuth();
      allow write: if isAdmin();
      // Allow users to update metrics (likes, bookmarks, shares, views)
      allow update: if isAuth(); 
    }
    
    match /shortInteractions/{docId} {
      allow read: if isAuth() && resource.data.userId == request.auth.uid;
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuth() && resource.data.userId == request.auth.uid;
    }
    
    match /realStories/{docId} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow update: if isAuth() && (resource.data.authorId == request.auth.uid || isAdmin());
      // Need to allow anyone to increment likes/comments/bookmarks
      allow update: if isAuth(); 
      allow delete: if isAuth() && (resource.data.authorId == request.auth.uid || isAdmin());
    }
    
    match /storyLikes/{docId} {
      allow read: if isAuth();
      allow write: if isAuth();
    }
    
    match /storyComments/{docId} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow update, delete: if isAuth() && (resource.data.authorId == request.auth.uid || isAdmin());
    }
    
    match /verifiedUsers/{docId} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }
    
    match /scamAlerts/{docId} {
      allow read: if isAuth();
      allow write: if isAdmin();
      // Allow users to report
      allow update: if isAuth(); 
    }
    
    match /scamAlertInteractions/{docId} {
      allow read: if isAuth() && resource.data.userId == request.auth.uid;
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuth() && resource.data.userId == request.auth.uid;
    }
    
    match /communityBookmarks/{docId} {
      allow read: if isAuth() && resource.data.userId == request.auth.uid;
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
      allow delete: if isAuth() && resource.data.userId == request.auth.uid;
    }

    // Support Requests
    match /supportRequests/{requestId} {
      allow read: if isAdmin();
      allow create: if isAuth();
      allow update: if isAdmin();
      allow delete: if false;
    }

    // Organizations
    match /organizations/{orgId} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }

    // Feedback
    match /feedback/{feedbackId} {
      allow read: if isAdmin();
      allow create: if isAuth();
      allow update, delete: if false;
    }
  }
}
